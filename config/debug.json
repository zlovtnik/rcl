{
  "service": {
    "log_level": "debug",
    "metrics_port": 9091,
    "otlp_endpoint": "http://localhost:4317",
    "health_check_timeout_ms": 5000,
    "shutdown_timeout_ms": 30000,
    "batch_flush_interval_ms": 100,
    "batch_max_bytes": 10485760
  },
  "kafka": {
    "brokers": "localhost:9092",
    "group_id": "rcl-consumer-group-debug-1",
    "session_timeout_ms": 45000,
    "max_inflight_messages": 500,
    "producer_retries": 5,
    "dlq_message_timeout_ms": 15000,
    "compression": "none",
    "staleness_threshold_seconds": 300
  },
  "postgres": {
    "url": "postgresql://rcl:rcl@localhost:5432/warehouse",
    "ssl_mode": "disable",
    "copy_enabled": true,
    "copy_batch_rows": 1,
    "insert_batch_rows": 1,
    "enable_offset_tracking": true,
    "pool": {
      "max_connections": 10,
      "acquire_timeout_ms": 5000
    }
  },
  "pipelines": [
    {
      "name": "example_pipeline",
      "topic": "cdc.example",
      "debezium_envelope": true,
      "staging_table": "stg_orders",
      "required_fields": [],
      "backpressure": {
        "channel_capacity": 20000
      },
      "worker_threads": 1,
      "circuit_breaker": {
        "enabled": true,
        "failure_threshold": 10,
        "success_threshold": 5,
        "half_open_timeout_ms": 30000
      },
      "dlq": {
        "topic": "dlq.example",
        "max_retries": 3,
        "max_payload_bytes": 1048576
      },
      "stages": [
        {
          "type": "transformer",
          "name": "pass_through",
          "config": {
            "operations": []
          }
        }
      ]
    }
  ]
}
