{
  "service": {
    "log_level": "info",
    "metrics_port": 9091,
    "health_check_timeout_ms": 5000,
    "shutdown_timeout_ms": 30000,
    "batch_flush_interval_ms": 5000,
    "batch_max_bytes": 10485760
  },
  "kafka": {
    "brokers": "localhost:9092",
    "group_id": "rcl-consumer-group-3",
    "session_timeout_ms": 45000,
    "max_inflight_messages": 500,
    "producer_retries": 5,
    "dlq_message_timeout_ms": 15000,
    "compression": "none",
    "staleness_threshold_seconds": 300
  },
  "postgres": {
    "url": "postgresql://rcl:rcl@localhost:5432/warehouse",
    "copy_enabled": true,
    "copy_batch_rows": 5000,
    "insert_batch_rows": 500,
    "pool": {
      "max_connections": 10,
      "acquire_timeout_ms": 5000
    }
  },
  "pipelines": [
    {
      "name": "example_pipeline",
      "topic": "cdc.example",
      "debezium_envelope": true,
      "staging_table": "staging_example",
      "required_fields": ["id"],
      "backpressure": {
        "channel_capacity": 20000
      },
      "dlq": {
        "topic": "dlq.example",
        "max_retries": 3,
        "max_payload_bytes": 1048576
      },
      "stages": [
        {
          "name": "active_records_filter",
          "type": "filter",
          "config": {
            "mode": "include",
            "conditions": [
              {
                "field": "status",
                "equals": "active"
              }
            ],
            "logic": "AND"
          }
        },
        {
          "name": "add_processed_timestamp",
          "type": "transformer",
          "config": {
            "transformations": [
              {
                "type": "add_field",
                "name": "processed_at",
                "value": "{{now}}"
              }
            ]
          }
        }
      ]
    }
  ]
}
